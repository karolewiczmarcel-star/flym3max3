        if getRole(plr) ~= "Murderer" then
            local tool = plr.Character:FindFirstChildOfClass("Tool")
            if tool and (tool.Name:lower():find("gun") or tool.Name:lower():find("revolver") or tool.Name:lower():find("pistol")) then
                local ray = cam:ViewportPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {plr.Character}
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude

                local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
                if result and result.Instance then
                    local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
                    if hitChar then
                        local targetPlayer = game.Players:GetPlayerFromCharacter(hitChar)
                        if targetPlayer and targetPlayer ~= plr and getRole(targetPlayer) == "Murderer" then
                            tool:Activate()
                        end
                    end
                end
            end
        end
    end
end)

